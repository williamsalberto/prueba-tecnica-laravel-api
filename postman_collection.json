						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"MacBook Pro 16 M3\",\n    \"description\": \"Portátil para desarrollo de software de alto rendimiento\",\n    \"price\": 2499.00,\n    \"currency_id\": 1,\n    \"tax_cost\": 374.85,\n    \"manufacturing_cost\": 1500.00\n}"
